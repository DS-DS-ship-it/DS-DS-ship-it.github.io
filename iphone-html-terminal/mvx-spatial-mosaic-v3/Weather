<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Pro Weather, Radar & Storm Motion Cockpit</title>
    
    <!-- Leaflet 2D Map CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Cesium 3D Engine Setup -->
    <script>window.CESIUM_BASE_URL = "https://unpkg.com/cesium@1.119.0/Build/Cesium/";</script>
    <link rel="stylesheet" href="https://unpkg.com/cesium@1.119.0/Build/Cesium/Widgets/widgets.css">
    <script src="https://unpkg.com/cesium@1.119.0/Build/Cesium/Cesium.js"></script>

    <!-- Aladin Lite Astronomy API (CDS Unistra) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://aladin.cds.unistra.fr/AladinLite/api/v2/latest/aladin.min.css" />
    <script src="https://aladin.cds.unistra.fr/AladinLite/api/v2/latest/aladin.min.js"></script>

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body, html { height: 100%; width: 100%; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; overflow: hidden; background: #070a12; color: #fff; }
        
        #viewWrap { position: relative; height: 100vh; width: 100vw; }
        #map2d, #map3d, #astroMap { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
        #map3d, #astroMap { display: none; }

        /* Crisp Radar Tile Rendering */
        .leaflet-tile-container img {
            image-rendering: -webkit-optimize-contrast;
            image-rendering: crisp-edges;
        }

        /* UI Overlay Structure */
        .ui-overlay { position: absolute; z-index: 1000; pointer-events: none; }
        .ui-overlay * { pointer-events: auto; }

        /* Top Bar Controls */
        .top-bar {
            top: 15px; left: 15px; right: 15px;
            display: flex; justify-content: space-between; align-items: center; gap: 10px;
        }

        .controls-group {
            display: flex; gap: 8px;
            background: rgba(15, 23, 42, 0.90); backdrop-filter: blur(12px);
            padding: 8px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

        .controls-group input, .controls-group select {
            background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18);
            color: #fff; padding: 7px 10px; border-radius: 6px; outline: none; font-size: 12px;
        }

        .btn {
            background: #007aff; color: #fff; border: none; padding: 7px 14px;
            border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 12px; transition: 0.2s;
        }
        .btn:hover { background: #0056b3; }
        .btn.active { background: #34c759; }

        /* Weather Report & Storm Motion Panel */
        .weather-panel {
            top: 75px; left: 15px; width: 330px; max-height: calc(100vh - 170px); overflow-y: auto;
            background: rgba(15, 23, 42, 0.92); backdrop-filter: blur(14px);
            color: #fff; padding: 16px; border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.18);
        }
        .weather-panel h2 { font-size: 17px; font-weight: 700; }
        .coords { font-size: 11px; color: #38bdf8; font-family: monospace; }
        .temp-header { display: flex; align-items: center; justify-content: space-between; margin: 8px 0; }
        .temp { font-size: 36px; font-weight: 800; }
        .condition { font-size: 13px; color: #cbd5e1; font-weight: 600; }
        
        /* Storm Vector Highlight Card */
        .motion-card {
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(0, 122, 255, 0.25));
            border: 1px solid rgba(56, 189, 248, 0.4);
            border-radius: 10px; padding: 10px; margin: 10px 0;
        }
        .motion-card .title { font-size: 11px; font-weight: 700; color: #38bdf8; text-transform: uppercase; }
        .motion-card .vector-text { font-size: 13px; font-weight: 700; margin-top: 4px; color: #fff; }

        /* NWS Alerts Container */
        .alert-banner {
            background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444;
            color: #fca5a5; padding: 8px; border-radius: 8px; font-size: 11px; font-weight: 600;
            margin-bottom: 8px; display: none;
        }

        .weather-stats {
            display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
            font-size: 11px; margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.12); padding-top: 8px;
        }
        .stat-item { background: rgba(255,255,255,0.05); padding: 6px 8px; border-radius: 6px; }
        .stat-label { color: #94a3b8; display: block; margin-bottom: 2px; font-size: 10px; text-transform: uppercase; }
        .stat-val { font-weight: 600; color: #f8fafc; }

        /* Zoom Controls */
        .zoom-controls {
            bottom: 85px; right: 15px;
            display: flex; flex-direction: column; gap: 6px;
        }
        .zoom-btn {
            background: rgba(15, 23, 42, 0.9); color: #fff; border: 1px solid rgba(255,255,255,0.2);
            width: 38px; height: 38px; border-radius: 8px; font-size: 18px; font-weight: bold;
            cursor: pointer; display: flex; align-items: center; justify-content: center;
        }
        .zoom-btn:hover { background: #007aff; }

        /* Radar Toolbar */
        .radar-bar {
            bottom: 20px; left: 50%; transform: translateX(-50%);
            display: flex; align-items: center; gap: 12px;
            background: rgba(15, 23, 42, 0.92); backdrop-filter: blur(14px);
            color: #fff; padding: 10px 20px; border-radius: 30px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.18);
        }
        .radar-bar button {
            background: #007aff; color: #fff; border: none; width: 36px; height: 36px;
            border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center;
        }
        .time-display { font-size: 12px; font-weight: 700; min-width: 140px; text-align: center; font-family: monospace; }
        
        /* Status Badge */
        .status-badge {
            top: 75px; right: 15px;
            background: rgba(15, 23, 42, 0.88); color: #34c759;
            padding: 6px 12px; border-radius: 20px; font-size: 11px; font-weight: 600;
            border: 1px solid rgba(52, 199, 89, 0.3); display: flex; align-items: center; gap: 6px;
        }
        .status-dot { width: 8px; height: 8px; background: #34c759; border-radius: 50%; }
        .status-badge.fallback { color: #ffcc00; border-color: rgba(255, 204, 0, 0.3); }
        .status-badge.fallback .status-dot { background: #ffcc00; }
    </style>
</head>
<body>

    <div id="viewWrap">
        <!-- Top Bar -->
        <div class="top-bar ui-overlay">
            <div class="controls-group">
                <input type="text" id="citySearch" placeholder="Search city or star..." onkeypress="if(event.key==='Enter') handleSearch()" style="width: 170px;" />
                <button class="btn" onclick="handleSearch()">Search</button>
            </div>

            <div class="controls-group">
                <select id="selBaseMap" onchange="changeBaseMap(this.value)">
                    <option value="sat">Satellite (Esri)</option>
                    <option value="osm">Standard Map (OSM)</option>
                    <option value="dark">Dark Canvas</option>
                    <option value="topo">Topographic</option>
                    <option value="nasa">NASA Blue Marble</option>
                </select>
            </div>

            <div class="controls-group">
                <button class="btn active" id="btnMode2D" onclick="switchMode('2d')">2D Map</button>
                <button class="btn" id="btnMode3D" onclick="switchMode('3d')">3D Globe</button>
                <button class="btn" id="btnModeAstro" onclick="switchMode('astro')">Astro (CDS)</button>
            </div>
        </div>

        <!-- Weather Report & Storm Motion Panel -->
        <div class="weather-panel ui-overlay" id="weatherPanel">
            <div class="alert-banner" id="alertBanner">⚠️ ACTIVE NWS WARNING IN AREA</div>
            <h2 id="locName">Select Location</h2>
            <div class="coords" id="locCoords">Click map or search a location</div>
            
            <div class="temp-header">
                <div class="temp" id="tempVal">--°C</div>
                <div id="weatherIcon" style="font-size: 36px;">🌡️</div>
            </div>
            <div id="weatherDesc" class="condition">Awaiting input</div>

            <!-- Storm Motion Analysis -->
            <div class="motion-card">
                <div class="title">🌩️ Storm Motion Vector</div>
                <div class="vector-text" id="motionText">Calculating travel trajectory...</div>
            </div>
            
            <div class="weather-stats">
                <div class="stat-item"><span class="stat-label">Barometer</span><span class="stat-val" id="pressureVal">-- hPa</span></div>
                <div class="stat-item"><span class="stat-label">Pressure Trend</span><span class="stat-val" id="pressureTrendVal">Steady</span></div>
                <div class="stat-item"><span class="stat-label">Wind Velocity</span><span class="stat-val" id="windVal">-- km/h</span></div>
                <div class="stat-item"><span class="stat-label">Wind Heading</span><span class="stat-val" id="windDirVal">--°</span></div>
                <div class="stat-item"><span class="stat-label">Feels Like</span><span class="stat-val" id="feelsLikeVal">--°C</span></div>
                <div class="stat-item"><span class="stat-label">Humidity</span><span class="stat-val" id="humidityVal">--%</span></div>
                <div class="stat-item"><span class="stat-label">Precip Prob</span><span class="stat-val" id="precipProbVal">--%</span></div>
                <div class="stat-item"><span class="stat-label">Flight Cat</span><span class="stat-val" id="flightCatVal">VFR</span></div>
            </div>
        </div>

        <!-- Zoom Controls -->
        <div class="zoom-controls ui-overlay">
            <button class="zoom-btn" onclick="handleZoom(1)">+</button>
            <button class="zoom-btn" onclick="handleZoom(-1)">−</button>
        </div>

        <!-- Radar Animation Player -->
        <div class="radar-bar ui-overlay" id="radarToolbar">
            <button id="playBtn" onclick="toggleRadarAnimation()">▶</button>
            <div class="time-display" id="radarTime">Loading Radar...</div>
            <div style="display:flex; align-items:center; gap:6px; font-size:11px; color:#94a3b8;">
                <span>Opacity</span>
                <input type="range" id="opacitySlider" min="0.1" max="1" step="0.05" value="0.75" oninput="updateOpacity(this.value)" style="accent-color:#007aff; cursor:pointer;">
            </div>
        </div>

        <!-- Status Indicator -->
        <div class="status-badge ui-overlay" id="statusBadge">
            <span class="status-dot"></span>
            <span id="statusText">Connecting Services...</span>
        </div>

        <!-- Map Containers -->
        <div id="map2d"></div>
        <div id="map3d"></div>
        <div id="astroMap"></div>
    </div>

    <script>
        // --- Application State ---
        const state = {
            mode: '2d',
            lat: 39.8283,
            lon: -98.5795,
            zoom: 5,
            opacity: 0.75,
            baseMap: 'sat',
            radarSource: 'RainViewer',
            radarFrames: [],
            radarLayers: [],
            noaaHdLayer: null,
            nwsAlertsLayer: null,
            trajectoryLayer: null,
            currentFrameIdx: 0,
            isPlaying: false,
            animTimer: null,
            marker: null,
            lastPressure: null
        };

        // --- 1. Initialize 2D Leaflet Map ---
        const map2d = L.map('map2d', {
            zoomControl: false,
            worldCopyJump: true,
            wheelDebounceTime: 40
        }).setView([state.lat, state.lon], state.zoom);

        // All Basemap Providers
        const baseLayers = {
            sat: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, attribution: '© Esri' }),
            osm: L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }),
            dark: L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom: 19, attribution: '© CartoDB' }),
            topo: L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', { maxZoom: 17, attribution: '© OpenTopoMap' }),
            nasa: L.tileLayer('https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/MODIS_Terra_CorrectedReflectance_TrueColor/default/2026-08-01/GoogleMapsCompatible_Level9/{z}/{y}/{x}.jpg', { maxZoom: 9, attribution: '© NASA GIBS' })
        };

        baseLayers.sat.addTo(map2d);

        // Labels Overlay
        const labelsLayer = L.tileLayer('https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19, zIndex: 500
        }).addTo(map2d);

        // NOAA HD Base Reflectivity Layer for high-res zoom
        state.noaaHdLayer = L.tileLayer('https://radar.weather.gov/arcgis/rest/services/radar/radar_base_reflectivity/MapServer/tile/{z}/{y}/{x}', {
            opacity: 0, // shown when zoomed in
            maxZoom: 19,
            keepBuffer: 10,
            zIndex: 250
        }).addTo(map2d);

        function changeBaseMap(key) {
            state.baseMap = key;
            Object.keys(baseLayers).forEach(k => {
                if (k === key) baseLayers[k].addTo(map2d);
                else map2d.removeLayer(baseLayers[k]);
            });
        }

        // --- 2. Initialize 3D Cesium Engine ---
        let viewer3d = null;

        function init3DEngine() {
            if (viewer3d) return true;
            try {
                viewer3d = new Cesium.Viewer('map3d', {
                    animation: false, timeline: false, geocoder: false, homeButton: false,
                    sceneModePicker: false, baseLayerPicker: false, navigationHelpButton: false,
                    infoBox: false, selectionIndicator: false, requestRenderMode: false,
                    terrainProvider: new Cesium.EllipsoidTerrainProvider()
                });

                viewer3d.imageryLayers.removeAll();
                viewer3d.scene.globe.enableLighting = false;

                const baseProvider = new Cesium.UrlTemplateImageryProvider({
                    url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
                    maximumLevel: 19
                });
                viewer3d.imageryLayers.addImageryProvider(baseProvider);
                return true;
            } catch (err) {
                console.error("3D Engine error:", err);
                return false;
            }
        }

        // --- 3. Initialize Aladin Lite Astronomy API (CDS Unistra) ---
        let aladinInstance = null;

        function initAstroEngine() {
            if (aladinInstance) return true;
            try {
                if (typeof A !== 'undefined') {
                    aladinInstance = A.aladin('#astroMap', {
                        survey: "P/DSS2/color",
                        fov: 60,
                        target: "0 0",
                        showReticle: false, showZoomControl: false, showFullscreenControl: false, showLayersControl: true, showGotoControl: false
                    });
                    return true;
                }
            } catch (err) {
                console.error("Aladin Lite load error:", err);
            }
            return false;
        }

        // --- View Mode Switcher ---
        function switchMode(newMode) {
            state.mode = newMode;
            document.querySelectorAll('.btn').forEach(btn => {
                if (['btnMode2D','btnMode3D','btnModeAstro'].includes(btn.id)) btn.classList.remove('active');
            });

            const m2d = document.getElementById('map2d');
            const m3d = document.getElementById('map3d');
            const mAstro = document.getElementById('astroMap');
            const weatherPanel = document.getElementById('weatherPanel');
            const radarToolbar = document.getElementById('radarToolbar');

            m2d.style.display = 'none'; m3d.style.display = 'none'; mAstro.style.display = 'none';

            if (newMode === '2d') {
                document.getElementById('btnMode2D').classList.add('active');
                m2d.style.display = 'block'; weatherPanel.style.display = 'block'; radarToolbar.style.display = 'flex';
                map2d.invalidateSize(); map2d.setView([state.lat, state.lon], state.zoom);
            } else if (newMode === '3d') {
                document.getElementById('btnMode3D').classList.add('active');
                m3d.style.display = 'block'; weatherPanel.style.display = 'block'; radarToolbar.style.display = 'flex';

                if (init3DEngine()) {
                    viewer3d.scene.globe.show = true;
                    const height = 40000000 / Math.pow(2, state.zoom);
                    viewer3d.camera.flyTo({
                        destination: Cesium.Cartesian3.fromDegrees(state.lon, state.lat, height),
                        duration: 1.0
                    });
                }
            } else if (newMode === 'astro') {
                document.getElementById('btnModeAstro').classList.add('active');
                mAstro.style.display = 'block'; weatherPanel.style.display = 'none'; radarToolbar.style.display = 'none';
                initAstroEngine();
            }
        }

        // --- Weather Radar System with Dual-Engine Scaling ---
        async function initRadar() {
            try {
                updateStatus("RainViewer + NOAA HD Auto-Blend", false);
                const res = await fetch('https://api.rainviewer.com/public/weather-maps.json');
                if (!res.ok) throw new Error("RainViewer HTTP " + res.status);
                
                const data = await res.json();
                const host = data.host;
                const past = data.radar?.past || [];

                if (past.length === 0) throw new Error("No radar frames");

                state.radarFrames = past;
                clearRadarLayers();

                state.radarLayers = past.map(frame => {
                    const tileUrl = `${host}${frame.path}/256/{z}/{x}/{y}/2/1_1.png`;
                    return L.tileLayer(tileUrl, {
                        opacity: 0,
                        maxNativeZoom: 7, // Stretches tiles seamlessly past zoom 7
                        maxZoom: 19,
                        keepBuffer: 10,   // Fixes tile disappearing on drag
                        updateWhenIdle: false,
                        updateWhenZooming: true,
                        zIndex: 200
                    });
                });

                state.radarLayers.forEach(l => l.addTo(map2d));
                showRadarFrame(state.radarLayers.length - 1);
                startRadarAnimation();

            } catch (err) {
                console.warn("RainViewer error; falling back to NOAA:", err);
                activateFallbackNOAA();
            }
        }

        function activateFallbackNOAA() {
            state.radarSource = "NOAA";
            clearRadarLayers();
            updateStatus("NOAA NEXRAD (Fallback)", true);

            const fallbackUrl = 'https://radar.weather.gov/arcgis/rest/services/radar/radar_base_reflectivity/MapServer/tile/{z}/{y}/{x}';
            const noaaLayer = L.tileLayer(fallbackUrl, { opacity: state.opacity, maxZoom: 19, keepBuffer: 10, zIndex: 200 });

            noaaLayer.addTo(map2d);
            state.radarLayers = [noaaLayer];
            document.getElementById('radarTime').innerText = "Live Reflectivity (NOAA)";
            document.getElementById('playBtn').disabled = true;
        }

        function clearRadarLayers() {
            if (state.animTimer) clearInterval(state.animTimer);
            state.radarLayers.forEach(l => map2d.removeLayer(l));
            state.radarLayers = [];
        }

        function showRadarFrame(index) {
            if (state.radarLayers.length === 0 || state.radarSource === "NOAA") return;

            // Auto-blend NOAA HD layer when zoomed in deep (Zoom >= 8)
            const isZoomedDeep = map2d.getZoom() >= 8;
            state.noaaHdLayer.setOpacity(isZoomedDeep ? state.opacity * 0.85 : 0);

            state.radarLayers.forEach((layer, idx) => {
                layer.setOpacity(idx === index ? state.opacity : 0);
            });

            state.currentFrameIdx = index;
            const timestamp = state.radarFrames[index]?.time;
            if (timestamp) {
                const date = new Date(timestamp * 1000);
                document.getElementById('radarTime').innerText = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + " UTC";
            }
        }

        function startRadarAnimation() {
            if (state.animTimer) clearInterval(state.animTimer);
            state.isPlaying = true;
            document.getElementById('playBtn').innerText = "⏸";

            state.animTimer = setInterval(() => {
                let nextIdx = (state.currentFrameIdx + 1) % state.radarLayers.length;
                showRadarFrame(nextIdx);
            }, 900);
        }

        function toggleRadarAnimation() {
            if (state.radarSource === "NOAA") return;
            if (state.isPlaying) {
                clearInterval(state.animTimer);
                state.isPlaying = false;
                document.getElementById('playBtn').innerText = "▶";
            } else {
                startRadarAnimation();
            }
        }

        function updateOpacity(val) {
            state.opacity = parseFloat(val);
            if (state.radarLayers[state.currentFrameIdx]) {
                state.radarLayers[state.currentFrameIdx].setOpacity(state.opacity);
            }
            if (map2d.getZoom() >= 8) state.noaaHdLayer.setOpacity(state.opacity * 0.85);
        }

        // --- NWS Active Alerts Layer ---
        async function fetchNWSAlerts() {
            try {
                const res = await fetch('https://api.weather.gov/alerts/active?status=actual');
                if (!res.ok) return;
                const data = await res.json();

                if (state.nwsAlertsLayer) map2d.removeLayer(state.nwsAlertsLayer);

                state.nwsAlertsLayer = L.geoJSON(data, {
                    style: (feature) => {
                        const event = feature.properties.event || '';
                        let color = '#f59e0b'; // Default Advisory
                        if (event.includes('Tornado') || event.includes('Extreme')) color = '#ef4444';
                        else if (event.includes('Thunderstorm')) color = '#eab308';
                        else if (event.includes('Flood')) color = '#06b6d4';

                        return { color: color, weight: 2, opacity: 0.8, fillColor: color, fillOpacity: 0.25 };
                    },
                    onEachFeature: (feature, layer) => {
                        layer.bindPopup(`<b>${feature.properties.event}</b><br>${feature.properties.headline || ''}`);
                    }
                }).addTo(map2d);
            } catch (err) {
                console.warn("NWS Alerts fetch error:", err);
            }
        }

        // --- Storm Motion Vector & Weather Report ---
        async function fetchMicroWeather(lat, lon, label = null) {
            document.getElementById('locName').innerText = label || `${lat.toFixed(2)}°, ${lon.toFixed(2)}°`;
            document.getElementById('locCoords').innerText = `Lat: ${lat.toFixed(4)}°, Lon: ${lon.toFixed(4)}°`;

            try {
                const omUrl = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&hourly=relative_humidity_2m,apparent_temperature,precipitation_probability,surface_pressure,cloudcover,visibility`;
                const res = await fetch(omUrl);
                if (!res.ok) throw new Error("HTTP " + res.status);
                
                const data = await res.json();
                const cur = data.current_weather;
                const hourly = data.hourly || {};

                document.getElementById('tempVal').innerText = `${Math.round(cur.temperature)}°C`;
                document.getElementById('weatherDesc').innerText = parseWMOCode(cur.weathercode);
                document.getElementById('windVal').innerText = `${cur.windspeed} km/h`;
                document.getElementById('windDirVal').innerText = `${cur.winddirection}°`;
                document.getElementById('feelsLikeVal').innerText = `${Math.round(hourly.apparent_temperature?.[0] ?? cur.temperature)}°C`;
                document.getElementById('humidityVal').innerText = `${hourly.relative_humidity_2m?.[0] ?? '--'}%`;
                document.getElementById('precipProbVal').innerText = `${hourly.precipitation_probability?.[0] ?? '0'}%`;
                
                // Pressure Tendency Analysis
                const pressure = Math.round(hourly.surface_pressure?.[0] ?? 1013);
                document.getElementById('pressureVal').innerText = `${pressure} hPa`;
                
                if (state.lastPressure !== null) {
                    const diff = pressure - state.lastPressure;
                    if (diff < -1.5) document.getElementById('pressureTrendVal').innerText = "📉 Rapid Drop (Storm Approaching)";
                    else if (diff > 1.5) document.getElementById('pressureTrendVal').innerText = "📈 Rising (Clearing)";
                    else document.getElementById('pressureTrendVal').innerText = "Steady";
                }
                state.lastPressure = pressure;

                // Aviation Flight Category Estimation
                const vis = (hourly.visibility?.[0] ?? 10000) / 1000; // km
                const clouds = hourly.cloudcover?.[0] ?? 0;
                let flightCat = "VFR 🟢";
                if (vis < 5 || clouds > 80) flightCat = "MVFR 🟡";
                if (vis < 3) flightCat = "IFR 🔴";
                document.getElementById('flightCatVal').innerText = flightCat;

                // Compute Storm Motion Vector
                computeStormMotion(lat, lon, cur.windspeed, cur.winddirection);

            } catch (err) {
                console.error("Weather error:", err);
                document.getElementById('weatherDesc').innerText = "Data Unavailable";
            }
        }

        // Draw Storm Trajectory Arrow
        function computeStormMotion(lat, lon, windSpeedKmh, windDirDeg) {
            // Steering wind blows FROM windDirDeg. Storm travels TOWARD (windDirDeg + 180) % 360
            const travelDir = (windDirDeg + 180) % 360;
            const cardinal = getCardinalDirection(travelDir);
            
            document.getElementById('motionText').innerText = `Moving Towards ${cardinal} (${travelDir}°) at ${windSpeedKmh} km/h`;

            // Draw Trajectory Vector Line (30-Minute Projected Distance)
            const distKm = windSpeedKmh * 0.5; // distance in 30 mins
            const rad = (travelDir * Math.PI) / 180;
            
            const targetLat = lat + (distKm / 111) * Math.cos(rad);
            const targetLon = lon + (distKm / (111 * Math.cos(lat * Math.PI / 180))) * Math.sin(rad);

            if (state.trajectoryLayer) map2d.removeLayer(state.trajectoryLayer);

            state.trajectoryLayer = L.layerGroup([
                L.polyline([[lat, lon], [targetLat, targetLon]], {
                    color: '#38bdf8', weight: 4, opacity: 0.85, dashArray: '8, 8'
                }),
                L.circleMarker([targetLat, targetLon], {
                    radius: 7, fillColor: '#007aff', color: '#fff', weight: 2, fillOpacity: 1
                }).bindPopup(`<b>Projected 30-Min Location</b><br>Heading: ${cardinal} (${travelDir}°)<br>Speed: ${windSpeedKmh} km/h`)
            ]).addTo(map2d);
        }

        function getCardinalDirection(deg) {
            const dirs = ['N', 'NNE', 'NE', 'ENE', 'E', 'ESE', 'SE', 'SSE', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'];
            return dirs[Math.round(deg / 22.5) % 16];
        }

        function parseWMOCode(code) {
            const table = {
                0: "Clear Sky ☀️", 1: "Mainly Clear 🌤️", 2: "Partly Cloudy ⛅", 3: "Overcast ☁️",
                45: "Fog 🌫️", 51: "Light Drizzle 🌦️", 61: "Slight Rain 🌧️", 63: "Moderate Rain 🌧️",
                65: "Heavy Rain ⛈️", 71: "Slight Snow 🌨️", 80: "Rain Showers 🌦️", 95: "Thunderstorm 🌩️"
            };
            return table[code] || "Moderate Conditions 🌡️";
        }

        function updateStatus(sourceName, isFallback) {
            const badge = document.getElementById('statusBadge');
            document.getElementById('statusText').innerText = "Radar: " + sourceName;
            badge.classList.toggle('fallback', isFallback);
        }

        function handleZoom(delta) {
            if (state.mode === '2d') map2d.setZoom(map2d.getZoom() + delta);
            else if (state.mode === '3d' && viewer3d) {
                const height = viewer3d.camera.positionCartographic.height;
                viewer3d.camera.moveForward(height * 0.35 * (delta > 0 ? -1 : 1));
            } else if (state.mode === 'astro' && aladinInstance) {
                if (delta > 0) aladinInstance.zoomIn(); else aladinInstance.zoomOut();
            }
        }

        map2d.on('click', (e) => {
            const { lat, lng } = e.latlng;
            state.lat = lat; state.lon = lng;
            if (state.marker) map2d.removeLayer(state.marker);
            state.marker = L.marker([lat, lng]).addTo(map2d);
            fetchMicroWeather(lat, lng);
        });

        map2d.on('zoomend moveend', () => {
            const center = map2d.getCenter();
            state.lat = center.lat; state.lon = center.lng; state.zoom = map2d.getZoom();
            if (state.radarLayers.length > 0) showRadarFrame(state.currentFrameIdx);
        });

        async function handleSearch() {
            const q = document.getElementById('citySearch').value.trim();
            if (!q) return;

            if (state.mode === 'astro') {
                if (aladinInstance) aladinInstance.gotoObject(q);
                return;
            }

            try {
                const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(q)}`);
                const results = await res.json();
                if (results.length === 0) return alert("Location not found");

                const loc = results[0];
                state.lat = parseFloat(loc.lat); state.lon = parseFloat(loc.lon);

                if (state.mode === '2d') {
                    map2d.flyTo([state.lat, state.lon], 9);
                    if (state.marker) map2d.removeLayer(state.marker);
                    state.marker = L.marker([state.lat, state.lon]).addTo(map2d);
                } else if (state.mode === '3d' && viewer3d) {
                    viewer3d.camera.flyTo({ destination: Cesium.Cartesian3.fromDegrees(state.lon, state.lat, 500000) });
                }
                fetchMicroWeather(state.lat, state.lon, loc.display_name.split(',')[0]);
            } catch (err) {
                alert("Search error: " + err.message);
            }
        }

        // --- Application Startup ---
        initRadar();
        fetchNWSAlerts();
        fetchMicroWeather(state.lat, state.lon, "Kansas, USA");
    </script>
</body>
</html>
